<UserControl
    x:Class="Media.Ui.Gui.DatabaseView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Media.Ui.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Media.Ui.Gui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ScrollViewer
            Grid.Column="0"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Expander
                    controls:AcordionBehaviour.IsAcordionGroup="True"
                    Header="Last played"
                    IsExpanded="True">
                    <StackPanel>
                        <Button
                            Command="{Binding GetFromRangeCommand}"
                            CommandParameter="today"
                            Content="Today"
                            Style="{StaticResource LinkButton}" />
                        <Button
                            Command="{Binding GetFromRangeCommand}"
                            CommandParameter="last3days"
                            Content="Last 3 days"
                            Style="{StaticResource LinkButton}" />
                        <Button
                            Command="{Binding GetFromRangeCommand}"
                            CommandParameter="week"
                            Content="This week"
                            Style="{StaticResource LinkButton}" />
                        <Button
                            Command="{Binding GetFromRangeCommand}"
                            CommandParameter="month"
                            Content="This Month"
                            Style="{StaticResource LinkButton}" />
                        <Button
                            Command="{Binding GetFromRangeCommand}"
                            CommandParameter="all"
                            Content="All time"
                            Style="{StaticResource LinkButton}" />
                    </StackPanel>
                </Expander>
                <Expander
                    controls:AcordionBehaviour.IsAcordionGroup="True"
                    Header="Maintenance">
                    <StackPanel>
                        <Button
                            Command="{Binding CleanupCommand}"
                            Content="Delete non existing played..."
                            Style="{StaticResource LinkButton}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <DataGrid
            x:Name="DatabaseGrid"
            Grid.Column="1"
            AutoGenerateColumns="True"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="True"
            CanUserResizeColumns="True"
            CanUserResizeRows="False"
            CanUserSortColumns="True"
            FontSize="{StaticResource ListFontSize}"
            IsReadOnly="True"
            ItemsSource="{Binding Results}"
            SelectionMode="Single"
            SelectionUnit="FullRow">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Command="{Binding PlayCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}"
                        Header="Play with mpv" />
                    <MenuItem
                        Command="{Binding SendToPlaylistCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}"
                        Header="Add to playlist" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>
