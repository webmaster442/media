<UserControl
    x:Class="Media.Ui.Gui.FilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Gui="clr-namespace:Media.Ui.Gui"
    xmlns:behaviours="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:controls="clr-namespace:Media.Ui.Controls"
    xmlns:converters="clr-namespace:Media.Ui.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Media.Ui.Gui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <ItemsControl
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            ItemsSource="{Binding Drives}"
            Style="{StaticResource VerticalItemsControl}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type Gui:DriveModel}">
                    <Button
                        Width="200"
                        HorizontalAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.DriveSelectCommand}"
                        CommandParameter="{Binding}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding Letter}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Text="{Binding Label}" />
                            <ProgressBar
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Width="180"
                                Height="15"
                                Maximum="1"
                                Minimum="0"
                                Value="{Binding PecentFull}" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                Text="{Binding TotalSize, Converter={converters:JoinConverter}, ConverterParameter=Total:}" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Text="{Binding FreeSpace, Converter={converters:JoinConverter}, ConverterParameter=Free:}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid
            Grid.Row="0"
            Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsControl
                Grid.Column="0"
                ItemsSource="{Binding PathParts}"
                Style="{StaticResource HorizontalItemsControl}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type Gui:PathPartModel}">
                        <Button
                            Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.NavigateCommand}"
                            CommandParameter="{Binding FullPath}"
                            Content="{Binding DisplayName}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal">
                <ToggleButton
                    x:Name="BookmarksBtn"
                    ToolTip="Bookmarks">
                    <controls:FontIcon
                        FontSize="22"
                        Glyph="FavoriteList" />
                </ToggleButton>
                <Popup
                    x:Name="BookmarksPopup"
                    IsOpen="{Binding ElementName=BookmarksBtn, Path=IsChecked}"
                    Placement="Left"
                    PlacementTarget="{Binding ElementName=BookmarksBtn}"
                    StaysOpen="False">
                    <Border
                        Width="300"
                        Padding="2"
                        Background="{StaticResource WindowBackgroundBrush}"
                        BorderBrush="{StaticResource CornerBorder}"
                        BorderThickness="1">
                        <ItemsControl
                            ItemsSource="{Binding Bookmarks}"
                            Style="{StaticResource VerticalItemsControl}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Grid.IsSharedSizeScope="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="{Binding Name}"
                                            ToolTip="{Binding Path}" />
                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding ElementName=BookmarksPopup, Path=PlacementTarget.DataContext.NavigateCommand}"
                                            CommandParameter="{Binding Path}">
                                            <controls:FontIcon
                                                FontSize="22"
                                                Glyph="RightArrowKeyTime0" />
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            Command="{Binding ElementName=BookmarksPopup, Path=PlacementTarget.DataContext.RemoveBookmarkCommand}"
                                            CommandParameter="{Binding}">
                                            <controls:FontIcon
                                                FontSize="22"
                                                Glyph="Remove" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                </Popup>
                <Button
                    Command="{Binding AddBookMarkCommand}"
                    ToolTip="Add current folder to bookmarks">
                    <controls:FontIcon
                        FontSize="22"
                        Glyph="Add" />
                </Button>
            </StackPanel>
        </Grid>
        <DataGrid
            x:Name="FolderView"
            Grid.Row="1"
            Grid.Column="1"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            ItemsSource="{Binding Items}"
            RowHeight="50"
            SelectedItem="{Binding SelectedItem}"
            SelectionMode="Single"
            SelectionUnit="FullRow">
            <behaviours:Interaction.Triggers>
                <behaviours:EventTrigger EventName="MouseDoubleClick">
                    <behaviours:InvokeCommandAction
                        Command="{Binding DoubleClickCommand}"
                        CommandParameter="{Binding SelectedItem}" />
                </behaviours:EventTrigger>
            </behaviours:Interaction.Triggers>
            <DataGrid.ContextMenu>
                <ContextMenu x:Name="CtxMenu">
                    <MenuItem
                        Command="{Binding PlayCommand}"
                        CommandParameter="{Binding SelectedItem}"
                        Header="Play with mpv" />
                    <MenuItem
                        Command="{Binding SendToPlaylistCommand}"
                        CommandParameter="{Binding SelectedItem}"
                        Header="Add to playlist" />
                    <Separator />
                    <MenuItem
                        Command="{Binding PreviewCommand}"
                        CommandParameter="{Binding SelectedItem}"
                        Header="Preview" />
                    <Separator />
                    <MenuItem
                        Command="{Binding SartShellCommand}"
                        CommandParameter="{Binding Path=CurrentPath}"
                        Header="Launch Media shell in current folder" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn
                    Width="Auto"
                    CanUserResize="False"
                    IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:FontIcon FontSize="32">
                                <controls:FontIcon.Glyph>
                                    <MultiBinding Converter="{converters:FileTypeToIconConverter}">
                                        <Binding Path="IsDirectory" />
                                        <Binding Path="FileType" />
                                    </MultiBinding>
                                </controls:FontIcon.Glyph>
                            </controls:FontIcon>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                    Width="*"
                    Header="Name"
                    IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Foreground="{Binding FileType, Converter={converters:FileTypeToColorConverter}}"
                                Text="{Binding Name}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    MinWidth="100"
                    Binding="{Binding Extension}"
                    Header="Extension"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="Auto"
                    MinWidth="100"
                    Binding="{Binding Size}"
                    Header="Size"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="Auto"
                    MinWidth="140"
                    Binding="{Binding LastModified}"
                    Header="Last modified"
                    IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
